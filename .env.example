# Copy to .env in this directory and add your own keys.
# Every script in the repository reads this single file.

# Worldwide-news collection (agent/data-sources/news-x-trends)
PERPLEXITY_API_KEY=

# X trend collection and concept generation (agent/data-sources, agent/pipeline)
XAI_API_KEY=

# Optional model overrides
PERPLEXITY_MODEL=sonar
XAI_MODEL=grok-4.5
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# Demo rounds and factory publishing on BNB Smart Chain testnet.
# Use a wallet that only ever holds testnet BNB, never a key that controls real funds.
DEMO_DEPLOYER_PRIVATE_KEY=
# Optional: publishes the source on BscScan so a round can be used from the explorer.
ETHERSCAN_API_KEY=

# Filled in after RegisterAgent and DeployFactory have run.
# Current BSC testnet values are in contracts/deployments/97.json.
AGENT_ID=
FACTORY=
# Public URL of the published/ directory, with no trailing slash.
# Example: https://raw.githubusercontent.com/MemeToro/memetoro/main/published
PUBLICATION_BASE_URL=
